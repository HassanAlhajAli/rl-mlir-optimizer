    },
    {
      "name": "adaptation",
      "argv": [
        "{python}",
        "scripts/run_adaptation.py",
        "--policy",
        "{output}/pretrain/policy.pt",
        "--output",
        "{output}/adaptation",
        "--workload-id",
        "b492eae50d11c001",
        "--reuse",
        "10000",
        "--budgets",
